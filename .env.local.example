# Echo — environment variables
# Copy to .env.local and fill in real values. NEVER commit real keys.
# Client-exposed vars must be prefixed NEXT_PUBLIC_.

# --- Supabase (auth + Postgres + pgvector + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side inserts/uploads + Flash workers
# Flash workers (ingest_coaching / coaching_rag) read the non-public name:
SUPABASE_URL=                       # same value as NEXT_PUBLIC_SUPABASE_URL

# --- Nebius Token Factory (OpenAI-compatible inference for coaching note) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- RunPod Flash ---
RUNPOD_API_KEY=
# `flash dev` defaults to http://127.0.0.1:8888. Set the deployed Flash base
# URL in production, or provide the two absolute endpoint URLs below.
RUNPOD_FLASH_BASE_URL=
RUNPOD_POSE_ENDPOINT_URL=
RUNPOD_RAG_ENDPOINT_URL=
RUNPOD_RANK_ENDPOINT_URL=
# Public clip URL for batch fan-out verify (orchestrate.py / /report live path)
BATCH_CLIP_URL=
BATCH_CLIP_COUNT=5

# --- Bright Data + embeddings (Flash workers: ingest + RAG) ---
# Bright Data dashboard → Account settings → API tokens
BRIGHTDATA_API_TOKEN=
OPENROUTER_API_KEY=

# Production auth redirects (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Shared secret gating the load-balanced RAG endpoint. Set the SAME value in the
# Next server env AND the flash deploy env (openssl rand -hex 32).
FLASH_SHARED_SECRET=
